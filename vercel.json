{
  "functions": {
    "app/api/webhooks/clerk/route.ts": {
      "maxDuration": 10
    }
  },
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/webhooks/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhooks/(.*)",
      "destination": "/api/webhooks/$1",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*svix.*"
        }
      ]
    }
  ]
} 
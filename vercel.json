{
  "functions": {
    "app/api/webhooks/clerk/route.ts": {
      "maxDuration": 30
    }
  },
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/webhooks/clerk",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhooks/clerk/",
      "destination": "/api/webhooks/clerk"
    }
  ]
} 
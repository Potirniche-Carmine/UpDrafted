{
  "name": "updrafted",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @updrafted/web",
    "dev:web": "npm run dev --workspace @updrafted/web",
    "dev:admin": "npm run dev --workspace @updrafted/admin",
    "dev:all": "concurrently \"npm run dev:web\" \"npm run worker:dev\"",
    "build": "npm run build --workspace @updrafted/web",
    "build:web": "npm run build --workspace @updrafted/web",
    "build:admin": "npm run build --workspace @updrafted/admin",
    "start": "npm run start --workspace @updrafted/web",
    "start:web": "npm run start --workspace @updrafted/web",
    "start:admin": "npm run start --workspace @updrafted/admin",
    "lint": "npm run lint --workspace @updrafted/web",
    "lint:web": "npm run lint --workspace @updrafted/web",
    "lint:admin": "npm run lint --workspace @updrafted/admin",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:introspect": "drizzle-kit introspect --config drizzle.config.ts",
    "worker:dev": "wrangler dev -c worker/wrangler.toml --remote",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.820.0",
    "@aws-sdk/s3-request-presigner": "^3.821.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@stripe/stripe-js": "^7.9.0",
    "@tanstack/react-query": "^5.79.0",
    "@tanstack/react-query-devtools": "^5.79.0",
    "@types/dompurify": "^3.0.5",
    "@upstash/redis": "^1.35.3",
    "better-auth": "^1.4.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "dotenv": "^16.5.0",
    "lucide-react": "^0.509.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-day-picker": "^9.8.1",
    "react-dom": "^19.1.0",
    "react-easy-crop": "^5.5.3",
    "resend": "^6.9.1",
    "stripe": "^20.3.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.62",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260210.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "eslint": "^9",
    "eslint-config-next": "^15.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5",
    "wrangler": "^4.64.0"
  },
  "overrides": {
    "better-call": {
      "zod": "$zod"
    }
  }
}
